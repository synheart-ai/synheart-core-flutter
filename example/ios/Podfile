platform :ios, '16.0'

# Tell the Synheart pods where this application root is.
#
# REQUIRED, not an optimisation. The synheart_core and syni podspecs symlink
# their vendored xcframework from <app>/synheart/vendor/... at `pod install`
# time. Without this they fall back to walking up from the pod's own source
# directory, which resolves differently per dependency kind and gets it wrong
# in both directions:
#
#   syni           → ~/.pub-cache/hosted/pub.dev/syni-x.y.z/
#                    Walking up climbs into pub-cache and never reaches an app
#                    root, so `pod install` fails outright with
#                    "could not locate <app>/synheart/vendor/syni-runtime/".
#
#   synheart_core  → the plugin checkout (a path dependency here)
#                    Walking up can reach a DIFFERENT project that happens to
#                    have a synheart/vendor/runtime/ios directory, and links
#                    that runtime instead of this app's — silently building
#                    against a binary this app's synheart.lock does not pin.
#
# Setting it explicitly makes both deterministic.
ENV['SYNHEART_APP_ROOT'] = File.expand_path('..', __dir__)

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # synheart_auth's iOS crypto and Keychain callbacks live in this pod.
  # CocoaPods trunk serves 0.1.0, which predates the Keychain
  # absent-vs-unavailable fix (0.1.2) and registration recovery (0.1.3), so
  # pin the release tag from git until trunk carries 0.1.3.
  pod 'SynheartAuth',
    :git => 'https://github.com/synheart-ai/synheart-auth-swift.git',
    :tag => 'v0.1.3'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Xcode 27 builds nothing below iOS 15; several plugin pods still declare
    # 9.0-14.0. Match the app's platform so every pod builds.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
