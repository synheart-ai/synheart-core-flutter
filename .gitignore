# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Local dependency overrides (developer-local, never committed).
pubspec_overrides.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native shared libraries (loaded at runtime, not committed)
*.so

# Native runtime binaries — installed via the Synheart CLI.
# Not committed to this repo.
ios/Frameworks/SynheartCoreRuntime.xcframework/
# Symlink the podspec prepare_command creates at pod-install time,
# pointing at the consumer app's vendor dir.
ios/SynheartCoreRuntime.xcframework
lib/libsynheart_core_runtime.dylib
native/

# Runtime artifacts installed by `synheart install runtime` (example app).
example/synheart/vendor/

# Claude Code
.claude/

# Generated files (commented out - we publish these for pub.dev)
# *.g.dart
# *.freezed.dart
.-flutter_guild.dart

/#Guidelines/

/example/android/app/src/main/jniLibs
/example/android/.settings
# Local endpoint defines (do not commit real endpoints)
# Dart-defines. Populated files carry organization identifiers and endpoints;
# only the placeholder templates are checked in. Covers both env/ roots, since
# the integration guide has developers copy a template in each.
env/*.json
!env/synheart.endpoints.example.json
env/*.local.json

.cursor/
# Example app dart-defines. Real org/app identifiers stay local; only the
# placeholder template is checked in.
example/env/*.json
!example/env/defines.example.json

# Agent instruction files. Local working guidance, not part of the published
# SDK — kept out of the repo so it can be edited freely without a review cycle.
CLAUDE.md
AGENTS.md
